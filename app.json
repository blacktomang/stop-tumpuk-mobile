{
  "expo": {
    "name": "stop-tumpuk",
    "slug": "stop-tumpuk",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "scheme": "stoptumpuk",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "text/uri-list"
            ]
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.arifsaqa.stoptumpuk"
    },
    "ios": {
      "supportsTablet": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5fd9e8b0-ae97-4302-a6c1-01d451b91806"
      }
    }
  }
}
